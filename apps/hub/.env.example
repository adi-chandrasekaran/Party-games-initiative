# Supabase Google OAuth. These browser-safe values are not secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
TRUSTED_ORIGINS=https://your-production-origin.example
# The legacy adapter is available only for documented local rollback checks.
ALLOW_LEGACY_PASSWORD_AUTH=false
VITE_HUB_API_URL=http://localhost:8787
VITE_PLATFORM_API_URL=http://localhost:8787
# Configure http://localhost:8787 and the production origin as Supabase redirect URLs.
