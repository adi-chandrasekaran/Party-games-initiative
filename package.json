{
  "name": "party-games",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "description": "One launcher app for multiple party games.",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=party-games-hub --filter=quiz-shooter-3d-client --filter=quiz-shooter-3d-server --filter=build-a-beast-client --filter=build-a-beast-server",
    "lint": "turbo run lint --filter='./apps/**' && eslint scripts tests --max-warnings=0",
    "type-check": "turbo run type-check --filter='./apps/**' && node scripts/verify-known-defects.mjs",
    "build": "turbo run build --filter=party-games-hub --filter=imposter-game --filter=planner-habit-tracker --filter=planner-todo-board --filter=planner-timer --filter=planner-assignments && node scripts/verify-known-defects.mjs",
    "test:unit": "turbo run test:unit --filter='./apps/**' && node --test tests/unit/*.test.mjs",
    "test:integration": "turbo run test:integration --filter='./apps/**' && node --test tests/integration/*.test.mjs",
    "test:e2e": "turbo run test:e2e --filter='./apps/**' && playwright test",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "workspace:check": "node --test tests/workspace/*.test.mjs"
  },
  "devDependencies": {
    "@forge/app-registry": "workspace:*",
    "@forge/contracts": "workspace:*",
    "@playwright/test": "1.55.0",
    "concurrently": "latest",
    "eslint": "9.21.0",
    "tsx": "latest",
    "turbo": "2.10.9",
    "vite": "latest"
  }
}
